      "parameters": {
        "jsCode": "function printNested(value, indent = '') {\n\tlet output = '';\n\n\tif (Array.isArray(value)) {\n\t\tvalue.forEach((item, index) => {\n\t\t\toutput += `${indent}[${index + 1}] `;\n\n\t\t\tif (typeof item === 'object' && item !== null) {\n\t\t\t\toutput += printNested(item, indent + '   ');\n\t\t\t} else {\n\t\t\t\toutput += `${indent}${item} `;\n\t\t\t}\n\t\t});\n\t} else if (typeof value === 'object' && value !== null) {\n\t\tObject.entries(value).forEach(([key, val]) => {\n\t\t\tif (typeof val === 'object' && val !== null) {\n\t\t\t\toutput += `${indent}${key}: `;\n\t\t\t\toutput += printNested(val, indent + '   ');\n\t\t\t} else {\n\t\t\t\toutput += `${indent}${key}: ${val} `;\n\t\t\t}\n\t\t});\n\t} else {\n\t\toutput += `${indent}${value} `;\n\t}\n\n\treturn output;\n}\n\nreturn items.map(item => {\n\tconst data = item.json;\n\tlet finalOutput = '';\n\n\tfinalOutput += `Patient: `;\n\tfinalOutput += printNested(data.patient, '   ');\n\tfinalOutput += ` `;\n\n\tdata.tests.forEach(test => {\n\t\tfinalOutput += `Test Name: ${test.test_name || 'Unknown'} `;\n\t\tfinalOutput += `======================== `;\n\n\t\tObject.entries(test).forEach(([key, value]) => {\n\t\t\tif (key === 'test_name') return;\n\n\t\t\tif (typeof value === 'object' && value !== null) {\n\t\t\t\tfinalOutput += `${key}: `;\n\t\t\t\tfinalOutput += printNested(value, '   ');\n\t\t\t} else {\n\t\t\t\tfinalOutput += `${key}: ${value} `;\n\t\t\t}\n\n\t\t\tfinalOutput += `--- `;\n\t\t});\n\n\t\tfinalOutput += ` `;\n\t});\n\n\treturn {\n\t\tjson: {\n\t\t\tpageContent: finalOutput,\n\t\t\tmetadata: {\n\t\t\t\tsource: 'lab_result',\n\t\t\t\tpatient_name: data.patient?.name || null,\n\t\t\t\ttest_count: data.tests?.length || 0\n\t\t\t}\n\t\t}\n\t};\n});"
      },
